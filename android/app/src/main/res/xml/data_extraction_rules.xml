<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 (API 31+) ignores android:allowBackup / fullBackupContent and
  reads this file instead, so both are required to actually keep member data
  out of backups. The app holds a session token and cached member records;
  neither should survive into a Google Drive backup or a device-to-device
  transfer, where it could be restored onto hardware the member does not
  control. Members re-authenticate on a new device instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
