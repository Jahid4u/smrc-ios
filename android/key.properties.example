# Copy this file to android/key.properties (same folder) and fill in your
# real values. NEVER commit the real key.properties or your .jks/.keystore
# file to git — both contain secrets that can sign an app as "you".
#
# See android/KEYSTORE_SETUP.md for how to generate the keystore itself.

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=upload
storeFile=/absolute/path/to/upload-keystore.jks
